#!/usr/bin/env bash
# The HUMAN runs this (from the project root, in a normal terminal) to list audit debt and to drop a
# stale entry — one whose role handed back without producing an artifact. The agent must never run it:
# an agent that can retire its own audit debt is not gated. Debt lives in one ledger per session,
# .agentic/<session_id>/audit-pending, plus the shared legacy .audit-pending that a pre-session install
# (or a payload with no session id) wrote; no session needs naming, because agent ids are unique.
# Entries are dropped BY agent_id, never by line position, so the wrong role cannot be cleared by a
# miscount. A LEGACY entry predating the metadata has no agent_id, so it is dropped by ROLE NAME
# instead — those really are interchangeable bare names, and refusing to clear them would leave
# hand-editing as the only exit.
ROOT="${CLAUDE_PROJECT_DIR:-$PWD}"
LEGACY="$ROOT/.audit-pending"

only=""
if [ "$1" = "--session" ]; then
  only="$2"; shift 2 2>/dev/null || shift $#
  case "$only" in ''|*[!A-Za-z0-9_-]*) echo "--session needs a session id made of letters, digits, _ and -."; exit 2 ;; esac
fi

# Ledgers to consider, legacy first. Only non-empty ones are listed; a --session names exactly one.
LEDGERS=()
if [ -n "$only" ]; then
  LEDGERS+=("$ROOT/.agentic/$only/audit-pending")
else
  LEDGERS+=("$LEGACY")
  for f in "$ROOT"/.agentic/*/audit-pending; do LEDGERS+=("$f"); done
fi

label () {
  if [ "$1" = "$LEGACY" ]; then echo "legacy (shared .audit-pending; not enforced for sessions that carry an id)"
  else d=${1%/audit-pending}; echo "session ${d##*/}"; fi
}

owed=0
for f in "${LEDGERS[@]}"; do [ -s "$f" ] && owed=1; done
[ "$owed" = 1 ] || { echo "No outstanding audit debt under $ROOT."; exit 0; }

# An empty argument is not an id: '$2==""' would match every legacy line, so treat it as "just list".
if [ $# -eq 0 ] || [ -z "$1" ]; then
  echo "Outstanding audit debt under $ROOT:"
  legacy=0
  for f in "${LEDGERS[@]}"; do
    [ -s "$f" ] || continue
    echo; echo "$(label "$f") — last modified $(date -u -r "$f" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo unknown)"
    # '|| [ -n "$r" ]' so a final line with no trailing newline is still listed.
    while IFS="$(printf '\t')" read -r r id ts || [ -n "$r" ]; do
      [ -n "$r" ] || continue
      if [ -n "$id" ]; then printf '  %-8s agent %-20s recorded %s\n' "$r" "$id" "${ts:-unknown}"
      else legacy=1; printf '  %-8s (no agent id: predates the metadata)\n' "$r"; fi
    done < "$f"
  done
  echo; echo "Drop one with:  $0 <agent_id>"
  [ "$legacy" = 1 ] && echo "                $0 <role>          for an entry with no agent id"
  echo "Drop it only if that role handed back WITHOUT producing an artifact."
  echo "An auditor clears the OLDEST entry for its role, so if a role's slices were audited out of"
  echo "order the surviving entry may carry the AUDITED run's id and time. Confirm the id you are"
  echo "about to drop really is the hand-back with no artifact behind it."
  exit 0
fi

for f in "${LEDGERS[@]}"; do
  [ -s "$f" ] || continue
  tmp="$f.tmp.$$"
  # A bare role name matches only the legacy file, the one place a no-agent-id entry can exist.
  if [ "$f" = "$LEGACY" ]; then m='($2==a || (NF==1 && $1==a))'; else m='($2==a)'; fi
  if awk -F'\t' -v a="$1" "BEGIN{done=0} $m && !done {done=1; next} {print} END{exit !done}" "$f" > "$tmp"; then
    if [ "$f" != "$LEGACY" ] && [ ! -s "$tmp" ]; then rm -f "$tmp" "$f"; else mv "$tmp" "$f"; fi   # an emptied session ledger is deleted, as the hook does
    echo "Dropped the entry matching '$1' from $(label "$f")."   # not necessarily an agent id: a legacy entry matches by role
    [ -s "$f" ] && { echo "Still owed there:"; cut -f1,2 < "$f" | sed 's/^/  /'; } || echo "That ledger is now empty."
    exit 0
  fi
  rm -f "$tmp"
done
echo "No entry matching '$1' (an agent id, or a role name for a legacy entry with none)."; echo "Run with no arguments to list what is owed."; exit 1
