#!/usr/bin/env bash
# The HUMAN runs this (from the project root, in a normal terminal) to clear the grilling gate
# after answering the agent's questions.
# The agent cannot run this itself while blocked — Write/Edit/Bash are gated. That is the point:
# only a human can release the gate, so a human confirmation is structurally required.
GATE="${CLAUDE_PROJECT_DIR:-$PWD}/.gate"
echo 'status: done' > "$GATE"
echo "Gate cleared → done ($GATE). The agent can change code again."
