#!/usr/bin/env bash
# The HUMAN runs this (from the project root, in a normal terminal) to clear a grilling gate
# after answering the agent's questions.
# The agent cannot run this itself while blocked — Write/Edit/Bash are gated. That is the point:
# only a human can release the gate, so a human confirmation is structurally required.
# Usage: unblock [<sid> | --legacy | --all]  (no argument: list; clear only if exactly one is blocked)
# No `set -e`: a missing gate must fall through to a message, not end the script silently.
ROOT="${CLAUDE_PROJECT_DIR:-$PWD}"

is_blocked() {
  [ -f "$1" ] || return 1
  [ "$(grep -vE '^[[:space:]]*#' "$1" | grep -oE '^[[:space:]]*status:[[:space:]]*(done|blocked)' | head -1 | awk '{print $2}')" = blocked ]
}

# `stat -c` is GNU, `stat -f` is BSD; GNU's `-f` means something else, so try GNU first.
age_of() {   # $1 file -> "3d" or "<1d"
  local m d; m=$(stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0)
  d=$(( ($(date +%s) - m) / 86400 )); [ "$d" -ge 1 ] && echo "${d}d" || echo "<1d"
}

# Keep the '#' question lines, exactly as gate-clear.sh does on the prompt path: the two release
# paths must leave the same record of what was released, or the audit trail depends on which one
# happened to be used.
release() {   # $1 gate file
  local GATE="$1" qs
  qs=$([ -f "$GATE" ] && grep -E '^[[:space:]]*#' "$GATE")
  { printf 'status: done\n'
    [ -n "$qs" ] && printf '%s\n' "$qs"
    printf '# released by hand via bin/unblock, %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z (%z)')"
  } > "$GATE"
  rm -f "$GATE-asked"          # the prompt receipt is meaningless once released by hand
  echo "Gate cleared → done ($GATE). The agent can change code again."
}

# Every blocked gate as "label<TAB>path", legacy first.
blocked=()
is_blocked "$ROOT/.gate" && blocked+=("legacy	$ROOT/.gate")
for g in "$ROOT"/.agentic/*/gate; do
  is_blocked "$g" && { d="${g%/gate}"; blocked+=("session ${d##*/}	$g"); }
done

list() {
  local e
  for e in "${blocked[@]}"; do
    echo "${e%%	*}  (${e#*	})  age $(age_of "${e#*	}")"
    grep -E '^[[:space:]]*#' "${e#*	}" | sed 's/^/    /'
  done
}

case "${1:-}" in
  --legacy)
    is_blocked "$ROOT/.gate" || { echo "No blocked legacy gate ($ROOT/.gate)." >&2; exit 1; }
    release "$ROOT/.gate" ;;
  --all)
    [ "${#blocked[@]}" -gt 0 ] || { echo "No blocked gate under $ROOT." >&2; exit 1; }
    for e in "${blocked[@]}"; do release "${e#*	}"; done ;;
  '')
    case "${#blocked[@]}" in
      0) echo "No blocked gate under $ROOT."; exit 0 ;;
      1) release "${blocked[0]#*	}" ;;
      *) echo "${#blocked[@]} gates are blocked; nothing cleared. Name one:" >&2
         list >&2
         echo "Run: unblock <session_id> | --legacy | --all" >&2
         exit 1 ;;
    esac ;;
  --*) echo "unknown option: $1" >&2; exit 2 ;;
  *)
    # An id is a path component: refuse anything that is not [A-Za-z0-9_-]+, as the hooks do.
    case "$1" in *[!A-Za-z0-9_-]*) echo "not a session id: $1" >&2; exit 2 ;; esac
    is_blocked "$ROOT/.agentic/$1/gate" || { echo "No blocked gate for session $1." >&2; list >&2; exit 1; }
    release "$ROOT/.agentic/$1/gate" ;;
esac
